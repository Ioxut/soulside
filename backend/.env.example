# ── Bază de date ─────────────────────────────────────────────────────────────
# Local (docker-compose): portul 5433. În producție: connection string Neon.
DATABASE_URL=postgresql://soulside:soulside@localhost:5433/soulside

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: în producție trebuie minim 32 de caractere random.
JWT_SECRET_KEY=inlocuieste-cu-un-sir-random-de-minim-32-caractere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Groq (LLM) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SoulSide <noreply@domeniultau.com>

# ── Aplicație ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
